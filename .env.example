# =============================================================================
#  Il Quiz – variabili d'ambiente
#  Copia questo file in ".env.local" (sviluppo) e imposta gli stessi valori
#  su Vercel (Project → Settings → Environment Variables).
#  Solo le variabili NEXT_PUBLIC_ sono visibili nel browser: tutte le altre
#  restano sul server.
# =============================================================================

# --- Supabase (Dashboard → Project Settings → API) ---------------------------
# URL del progetto, es. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Chiave "service_role" / secret key (SEGRETA: mai nel frontend, mai su Git)
SUPABASE_SERVICE_ROLE_KEY=

# --- Amministratore (/admin) -------------------------------------------------
ADMIN_USERNAME=
# Password lunga e unica (almeno 12 caratteri)
ADMIN_PASSWORD=

# --- Postazione del quiz (/postazione) ---------------------------------------
# Credenziali con cui il personale abilita il dispositivo su cui giocano i
# clienti. Se non impostate valgono ancora CASSA_USERNAME / CASSA_PASSWORD.
POSTAZIONE_USERNAME=
# Password diversa da quella dell'amministratore
POSTAZIONE_PASSWORD=

# --- Sessioni ----------------------------------------------------------------
# Stringa casuale di almeno 32 caratteri: firma le sessioni di admin,
# postazione e partita. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Opzionali ---------------------------------------------------------------
# Logo personalizzato copiato in /public (es. /logo.svg). Vuoto = logo "Il Quiz".
NEXT_PUBLIC_LOGO_URL=
