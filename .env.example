# =============================================================================
#  Il Quiz del Giorno – variabili d'ambiente
#  Copia questo file in ".env.local" (sviluppo) e imposta gli stessi valori
#  su Vercel (Project → Settings → Environment Variables).
#  NESSUNA di queste variabili deve iniziare con NEXT_PUBLIC_, tranne quelle
#  indicate come pubbliche: tutte le altre restano solo sul server.
# =============================================================================

# --- Supabase (Dashboard → Project Settings → API) ---------------------------
# URL del progetto, es. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Chiave "service_role" (SEGRETA: mai nel frontend, mai su Git)
SUPABASE_SERVICE_ROLE_KEY=

# --- Amministratore (/admin) -------------------------------------------------
ADMIN_USERNAME=
# Usa una password lunga e unica (almeno 12 caratteri)
ADMIN_PASSWORD=
# Stringa casuale di almeno 32 caratteri per firmare la sessione.
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Personalizzazione (pubbliche, opzionali) --------------------------------
# Percorso del logo ufficiale copiato in /public (es. /logo.svg). Vuoto = nome testuale.
NEXT_PUBLIC_LOGO_URL=
# Nome mostrato al posto del logo e come testo alternativo
NEXT_PUBLIC_BRAND_NAME=McDonald's
